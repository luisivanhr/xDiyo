from __future__ import annotations
import re
import numpy as np
import pandas as pd
from typing import Iterator, Tuple, Optional
from sklearn.model_selection import BaseCrossValidator

def _first_year(season_str: str) -> int:
    m = re.search(r'(\d{4})', str(season_str))
    if m:
        return int(m.group(1))
    m2 = re.search(r'(\d+)', str(season_str))
    if m2:
        return int(m2.group(1))
    raise ValueError(f"Cannot parse season year from: {season_str!r}")

class SeasonRoundTimeSeriesSplit(BaseCrossValidator):
    """
    Time-series CV for football data with (season, round), multi-league, and per-season warm-up.

    Train = all seasons strictly before the first validation season,
            + the first `season_warmup` rounds from the first validation season (cap-safe).
    Valid = `valid_seasons` contiguous seasons starting at fold start,
            with the warm-up rounds removed from the first validation season.

    Parameters
    ----------
    season_col : str
    round_col : str
    start_season : Optional[str]
        e.g. '2018/2019'. If None, uses earliest season in data.
    n_splits : int
    valid_seasons : int
    season_warmup : int
        Number of **rounds** from the first validation season to include in TRAIN.
    step_seasons : Optional[int]
        Fold stride in seasons. Default = valid_seasons (non-overlapping).
    ensure_min_val_rounds : int
        Minimum number of validation rounds that must remain in the FIRST validation season
        after warm-up. If warm-up is too large, it is **capped** so at least this many rounds remain.
        Set to 0 to disable capping.
    maximum_validation_rounds : Optional[int]
        If None (default), validation includes all rounds of all `valid_seasons` seasons for the fold
        (minus warm-up rounds in the first validation season).
        If an integer N is provided, the **validation fold is restricted to the first N rounds of the
        FIRST validation season only** (after removing warm-up). This is useful to test early-season /
        post-break performance and prevents later-season data from entering validation for that fold.

    Notes
    -----
    * Requires X to be a pandas DataFrame with columns [season_col, round_col].
    * Does NOT sort X; it works by boolean masks → indices.
    * Warm-up is applied per-round across ALL leagues within that season.
    """

    def __init__(
        self,
        season_col: str = "season",
        round_col: str = "round",
        *,
        start_season: Optional[str] = None,
        n_splits: int = 5,
        valid_seasons: int = 1,
        season_warmup: int = 0,
        step_seasons: Optional[int] = None,
        ensure_min_val_rounds: int = 1,
        maximum_validation_rounds: Optional[int] = None,
    ):
        if n_splits < 1:
            raise ValueError("n_splits must be >= 1")
        if valid_seasons < 1:
            raise ValueError("valid_seasons must be >= 1")
        if season_warmup < 0:
            raise ValueError("season_warmup must be >= 0")
        if ensure_min_val_rounds < 0:
            raise ValueError("ensure_min_val_rounds must be >= 0")
        if maximum_validation_rounds is not None and maximum_validation_rounds < 1:
            raise ValueError("maximum_validation_rounds must be >= 1 or None")

        self.season_col = season_col
        self.round_col = round_col
        self.start_season = start_season
        self.n_splits = int(n_splits)
        self.valid_seasons = int(valid_seasons)
        self.season_warmup = int(season_warmup)
        self.step_seasons = int(step_seasons) if step_seasons is not None else int(valid_seasons)
        self.ensure_min_val_rounds = int(ensure_min_val_rounds)
        self.maximum_validation_rounds = maximum_validation_rounds

    def get_n_splits(self, X=None, y=None, groups=None) -> int:
        return self.n_splits

    def _validate_inputs(self, X: pd.DataFrame):
        if not isinstance(X, pd.DataFrame):
            raise TypeError("X must be a pandas DataFrame.")
        if self.season_col not in X or self.round_col not in X:
            raise TypeError(f"X must contain columns {self.season_col!r} and {self.round_col!r}.")

        seasons = X[self.season_col].to_numpy()
        rounds = X[self.round_col].to_numpy()
        if not np.issubdtype(rounds.dtype, np.number):
            raise ValueError(f"{self.round_col!r} must be numeric (integer rounds).")
        rounds = rounds.astype(int)

        years = np.array([_first_year(s) for s in seasons], dtype=int)
        uniq_years = np.array(sorted(np.unique(years)))

        if self.start_season is None:
            start_year = int(uniq_years[0])
        else:
            req_year = _first_year(self.start_season)
            after = uniq_years[uniq_years >= req_year]
            if len(after) == 0:
                raise ValueError("start_season is after all seasons in data.")
            start_year = int(after[0])

        return years, rounds, uniq_years, start_year

    def split(self, X: pd.DataFrame, y=None, groups=None) -> Iterator[Tuple[np.ndarray, np.ndarray]]:
        years, rounds, uniq_years, start_year = self._validate_inputs(X)
        n_samples = len(X)

        # Precompute index lists per season and max round per season
        idx_by_year = {yr: np.flatnonzero(years == yr) for yr in uniq_years}
        max_round_by_year = {yr: (rounds[idx].max() if idx.size else 0) for yr, idx in idx_by_year.items()}

        start_pos = int(np.where(uniq_years == start_year)[0][0])
        # Ensure we have enough seasons to allocate n_splits validation blocks
        total_needed = start_pos + self.n_splits * self.step_seasons + (self.valid_seasons - self.step_seasons)
        if total_needed > len(uniq_years):
            max_splits = (len(uniq_years) - start_pos - (self.valid_seasons - self.step_seasons)) // self.step_seasons
            raise ValueError(
                f"Not enough seasons to create {self.n_splits} folds starting at {start_year}. "
                f"Maximum possible with these settings: {max_splits}."
            )

        for k in range(self.n_splits):
            val_start_pos = start_pos + k * self.step_seasons
            val_years = uniq_years[val_start_pos : val_start_pos + self.valid_seasons]
            first_val_year = int(val_years[0])

            # ----- Warm-up cap (keeps at least `ensure_min_val_rounds` in validation) -----
            # If maximum_validation_rounds is set, we cap warm-up relative to that window,
            # so that some validation rounds remain within the early-rounds window.
            warmup_cap = self.season_warmup
            if self.ensure_min_val_rounds > 0:
                season_max_r = max_round_by_year.get(first_val_year, 0)
                if season_max_r > 0:
                    # Effective ceiling for validation rounds when a max window is set
                    if self.maximum_validation_rounds is not None:
                        effective_val_ceiling = min(season_max_r, int(self.maximum_validation_rounds))
                    else:
                        effective_val_ceiling = season_max_r
                    warmup_cap = min(self.season_warmup, effective_val_ceiling - self.ensure_min_val_rounds)
                    warmup_cap = max(0, warmup_cap)  # never negative

            # Train = seasons < first_val_year
            train_mask = (years < first_val_year)

            # Include warm-up rounds from first validation season into train
            if warmup_cap > 0:
                idx_fv = idx_by_year.get(first_val_year, np.array([], dtype=int))
                if idx_fv.size:
                    warm = idx_fv[rounds[idx_fv] <= warmup_cap]
                    if warm.size:
                        m = np.zeros(n_samples, dtype=bool)
                        m[warm] = True
                        train_mask = np.logical_or(train_mask, m)

            # ----- Validation mask construction -----
            if self.maximum_validation_rounds is None:
                # Validation = all samples in selected validation seasons
                val_mask = np.isin(years, val_years)
                # Remove warm-up from validation (first validation season only)
                if warmup_cap > 0:
                    idx_fv = idx_by_year.get(first_val_year, np.array([], dtype=int))
                    if idx_fv.size:
                        warm = idx_fv[rounds[idx_fv] <= warmup_cap]
                        if warm.size:
                            m = np.zeros(n_samples, dtype=bool)
                            m[warm] = True
                            val_mask = np.logical_and(val_mask, ~m)
            else:
                # Validation restricted to the FIRST validation season, rounds <= maximum_validation_rounds
                N = int(self.maximum_validation_rounds)
                in_first_val = (years == first_val_year)
                early_rounds = (rounds <= N)
                val_mask = np.logical_and(in_first_val, early_rounds)
                # Exclude warm-up window from validation
                if warmup_cap > 0:
                    not_warm = (rounds > warmup_cap)
                    val_mask = np.logical_and(val_mask, not_warm)

            train_idx = np.flatnonzero(train_mask)
            test_idx  = np.flatnonzero(val_mask)

            if train_idx.size == 0 or test_idx.size == 0:
                raise ValueError(
                    f"Fold {k} is empty (train={train_idx.size}, valid={test_idx.size}). "
                    "Adjust start_season, valid_seasons, season_warmup, step_seasons, "
                    "ensure_min_val_rounds, or maximum_validation_rounds."
                )

            yield train_idx, test_idx

    # -------- Convenience: quick fold summary (optional) --------
    def summarize_folds(self, X: pd.DataFrame):
        """Return a DataFrame with fold number, train/valid sizes, and validation season range."""
        years, _, uniq_years, start_year = self._validate_inputs(X)
        start_pos = int(np.where(uniq_years == start_year)[0][0])

        rows = []
        for k, (tr, va) in enumerate(self.split(X), 1):
            val_start_pos = start_pos + (k - 1) * self.step_seasons
            val_years = uniq_years[val_start_pos : val_start_pos + self.valid_seasons]
            rows.append({
                "fold": k,
                "train_n": len(tr),
                "valid_n": len(va),
                "valid_years": tuple(int(y) for y in val_years),
                "valid_round_cap": self.maximum_validation_rounds,
                "train_last_year": int(years[tr].max()) if len(tr) else None,
                "valid_first_year": int(years[va].min()) if len(va) else None,
            })
        return pd.DataFrame(rows)
