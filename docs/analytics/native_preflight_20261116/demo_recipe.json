{
  "version": 1,
  "name": "Corners experiment",
  "output_dir": "experiments",
  "config": {},
  "team_badges": null,
  "data": {
    "data_root": "data/xDiyo_data",
    "query": {
      "competitions": "HNL",
      "seasons": 61243
    },
    "tables": [
      "matches",
      "team_seasons"
    ]
  },
  "data_selection": null,
  "dataset_migration": null,
  "native_preprocessing": {
    "availability": "retrospective_finished",
    "entry_information": "retrospective_season_entry"
  },
  "stat_selection": null,
  "history": {},
  "feature_options": {},
  "cutoff_hours": 24,
  "feature_preset": null,
  "preset_seasons": null,
  "derived_features": {},
  "context_features": {},
  "identity_features": null,
  "numeric_features": null,
  "ratings": {},
  "features": {
    "countdown": {
      "component": "features.SeasonCountdown",
      "params": {}
    },
    "form": {
      "component": "features.DerivedStandings",
      "params": {
        "normalized_ranks": [
          5
        ]
      }
    }
  },
  "labels": {
    "outcome": {
      "component": "labels.Outcome",
      "params": {
        "perspective": "home"
      }
    }
  },
  "target": "outcome",
  "assembly": {
    "layout": "match",
    "drop_missing_targets": true
  },
  "split": {
    "component": "splits.TemporalSplit",
    "params": {
      "train_size": 10,
      "test_size": 5,
      "unit": "rounds"
    }
  },
  "split_options": {},
  "fold_ids": null,
  "pre_reporters": {},
  "fitted_reporters": {},
  "analysis_options": {},
  "model": {
    "component": "sklearn.linear_model.Lasso",
    "params": {
      "alpha": 0.1,
      "max_iter": 5000
    }
  },
  "preprocessors": [
    {
      "component": "sklearn.impute.SimpleImputer",
      "params": {
        "strategy": "median"
      }
    },
    {
      "component": "sklearn.preprocessing.StandardScaler",
      "params": {}
    }
  ],
  "adapter": null,
  "target_transformer": null,
  "prediction_methods": [
    "predict"
  ],
  "candidate": {},
  "search": null,
  "execution": {
    "component": "training.ExecutionPolicy",
    "params": {}
  },
  "refit": null,
  "checkpoint": null,
  "post_reporters": {
    "performance": {
      "component": "reporting.PerformanceReporter",
      "params": {
        "type": "overall",
        "partition": "score",
        "metrics": [
          "mse",
          "mae"
        ]
      }
    },
    "matches": {
      "component": "reporting.MatchResultReporter",
      "params": {
        "type": "overall",
        "partition": "score",
        "catalog": {
          "ref": "team_catalog"
        },
        "show_badges": true
      }
    }
  },
  "run": {
    "reuse": true
  },
  "artifact_export": null,
  "prediction": {
    "model_path": "",
    "rounds": null,
    "statuses": [
      "notstarted"
    ],
    "as_of": null
  }
}
